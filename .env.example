# Copy to .env and fill in. NOTHING sensitive has a default in settings.py —
# a missing key fails at startup rather than silently using a baked-in value.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
LOG_LEVEL=INFO

POSTGRES_DB=zory_pipeline
POSTGRES_USER=zory
POSTGRES_PASSWORD=local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Pipeline tunables
DETECTION_CONFIDENCE_THRESHOLD=0.10
IMAGE_MIN_DIMENSION=400
STAGE_CLAIM_BATCH=100
STAGE_STUCK_TIMEOUT_MINUTES=30
ICON_MAX_ATTEMPTS=2

# External services (Phase 1+, not needed for the review tabs)
# MODAL_URL=
# MODAL_KEY=
# MODAL_SECRET=
OPENAI_API_KEY=
PINECONE_API_KEY=
# GOOGLE_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=

# Pinecone — a separate DEV index, never the production one
PINECONE_INDEX_NAME=zory-pipeline-dev

# Detection (Modal)
MODAL_URL=
MODAL_KEY=
MODAL_SECRET=
DETECTION_TIMEOUT_SECONDS=145
INGESTION_MAX_ATTEMPTS=2

# Images
IMAGE_MAX_DIMENSION=4096
IMAGE_MAX_FILE_SIZE_MB=10

# Embedding (Gemini)
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2-preview

# Vectors
PINECONE_DIMENSION=3072
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# 2D icons
ICON_MODEL=gpt-image-2
ICON_QUALITY=low
ICON_SIZE=1024x1024
ICON_GENERATION_RETRIES=5

# S3
S3_BUCKET=zory-icons-dev
S3_ICON_PREFIX=2D_icons
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
